    {"rule": "https-non-www", "scheme": "https", "host": "example.com", "uri": "/a", "ok": false, "url": ""},
    {"rule": "www", "scheme": "http", "host": "example.com", "uri": "/a", "ok": true, "url": "http://www.example.com/a"},
