    {"rule": "www", "scheme": "http", "host": "WWW.example.com", "uri": "/a", "ok": false, "url": ""},
    {"rule": "non-www", "scheme": "http", "host": "www.example.com", "uri": "/a", "ok": true, "url": "http://example.com/a"},
    {"rule": "non-www", "scheme": "https", "host": "WWW.example.com", "uri": "/a?b=c", "ok": true, "url": "https://example.com/a?b=c"},
    {"rule": "non-www", "scheme": "http", "host": "example.com", "uri": "/a", "ok": false, "url": ""}
  ],
  "redirectHost": [
    {"host": "example.com", "valid": true},
    {"host": "example.com:8080", "valid": true},
    {"host": "[::1]:8080", "valid": true},
    {"host": "www.example.com", "valid": true},
    {"host": "", "valid": false},
    {"host": "www.", "valid": false},
    {"host": "WWW.", "valid": false},
    {"host": "www.:80", "valid": false},
    {"host": ":80", "valid": false},
    {"host": ".example.com", "valid": false},
    {"host": "example.com%2fpath", "valid": false}
  ],
  "acceptsGzip": [
    {"acceptEncoding": ["gzip"], "accepts": true},
    {"acceptEncoding": ["x-gzip"], "accepts": true},
    {"acceptEncoding": ["GZIP"], "accepts": true},
    {"acceptEncoding": ["deflate, gzip;q=0.5"], "accepts": true},
    {"acceptEncoding": ["gzip; q=0.001"], "accepts": true},
    {"acceptEncoding": ["*"], "accepts": true},
    {"acceptEncoding": ["*;q=0", "gzip"], "accepts": true},
    {"acceptEncoding": ["gzip;q=0"], "accepts": false},
    {"acceptEncoding": ["gzip;q=0.000"], "accepts": false},
    {"acceptEncoding": ["gzip;q=1.001"], "accepts": false},
    {"acceptEncoding": ["gzip;q=abc"], "accepts": false},
    {"acceptEncoding": ["gzip", "gzip;q=0"], "accepts": false},
    {"acceptEncoding": ["*;q=0"], "accepts": false},
    {"acceptEncoding": ["*", "*;q=0"], "accepts": false},
    {"acceptEncoding": ["deflate", "br"], "accepts": false},
    {"acceptEncoding": ["identity"], "accepts": false},
    {"acceptEncoding": [], "accepts": false}
  ],
  "contentCoding": [
    {"contentEncoding": ["br"], "has": true},
    {"contentEncoding": ["gzip"], "has": true},
    {"contentEncoding": ["identity, br"], "has": true},
    {"contentEncoding": ["identity", "deflate"], "has": true},
    {"contentEncoding": ["identity"], "has": false},
    {"contentEncoding": ["IDENTITY"], "has": false},
    {"contentEncoding": [""], "has": false},
    {"contentEncoding": [" , "], "has": false},
    {"contentEncoding": [], "has": false}
  ],
  "escape": [
    {"in": "/docs", "out": "/docs"},
    {"in": "/x\t/y", "out": "/x%09/y"},
    {"in": "/a\nb", "out": "/a%0Ab"},
    {"in": "/a\rb", "out": "/a%0Db"},
    {"in": "/a\u007fb", "out": "/a%7Fb"},
    {"in": "/a\u0000b", "out": "/a%00b"},
    {"in": "/a\u001fb", "out": "/a%1Fb"},
    {"in": "/café", "out": "/café"},
    {"in": "//attacker.example/x", "out": "//attacker.example/x"},
    {"in": "", "out": "", "direct": true},
    {"in": "\tabc", "out": "%09abc", "direct": true}
  ],
  "sanitize": [
    {"in": "/path", "out": "/path"},
    {"in": "//example.com", "out": "/example.com"},
    {"in": "///example.com/a", "out": "/example.com/a"},
    {"in": "/a/b?x=1", "out": "/a/b?x=1"},
    {"in": "//example.com?next=//other", "out": "/example.com?next=//other"},
    {"in": "/a?x=\ty", "out": "/a?x=%09y"},
    {"in": "//example.com/", "out": "/example.com/"},
    {"in": "/dir/?q=1", "out": "/dir/?q=1"},
    {"in": "", "out": "", "direct": true},
    {"in": "/", "out": "/", "direct": true},
    {"in": "/\\example.com", "out": "/example.com", "direct": true},
    {"in": "\\\\example.com", "out": "/example.com", "direct": true},
    {"in": "/\t/example.com", "out": "/%09/example.com", "direct": true},
    {"in": "\t//example.com", "out": "%09//example.com", "direct": true}
  ],
  "pathSegment": [
    {"path": "", "unclean": false},
    {"path": "/", "unclean": false},
    {"path": "/index.html", "unclean": false},
    {"path": "/css/app.css", "unclean": false},
    {"path": "/css/app.css/", "unclean": false},
    {"path": "/dir\\file.txt", "unclean": false},
    {"path": "/...", "unclean": false},
    {"path": "/..foo", "unclean": false},
    {"path": "/..", "unclean": true},
    {"path": "/a/../b", "unclean": true},
    {"path": "/a/./b", "unclean": true},
    {"path": "/a//b", "unclean": true},
    {"path": "//a", "unclean": true},
    {"path": "/..\\secret.txt", "unclean": true},
    {"path": "/a\\..\\b", "unclean": true}
  ],
  "wildcardPath": [
    {"p": "file", "routePath": "/assets/*", "unclean": false},
    {"p": "css/app.css", "routePath": "/assets/*", "unclean": false},
    {"p": "", "routePath": "/assets/*", "unclean": false},
    {"p": "/file", "routePath": "/assets*", "unclean": false},
    {"p": "/", "routePath": "/assets*", "unclean": false},
    {"p": "/file", "routePath": "/assets/*", "unclean": true},
    {"p": "/", "routePath": "/*", "unclean": true},
    {"p": "../secret", "routePath": "/assets/*", "unclean": true},
    {"p": "..", "routePath": "/assets*", "unclean": true},
    {"p": "a//b", "routePath": "/assets*", "unclean": true},
    {"p": "a\\..\\b", "routePath": "/*", "unclean": true}
  ],
  "origin": [
    {"allowed": ["https://example.com"], "origin": "https://example.com", "match": "https://example.com", "ok": true},
    {"allowed": ["https://example.com"], "origin": "https://EXAMPLE.com", "match": "https://example.com", "ok": true},
    {"allowed": ["https://a.example", "https://b.example"], "origin": "https://b.example", "match": "https://b.example", "ok": true},
    {"allowed": ["https://Example.com", "https://example.com"], "origin": "https://example.com", "match": "https://Example.com", "ok": true},
    {"allowed": ["https://example.com"], "origin": "http://example.com", "match": "", "ok": false},
    {"allowed": ["https://example.com"], "origin": "https://example.com.evil.test", "match": "", "ok": false},
    {"allowed": ["https://example.com"], "origin": "https://example.com:8443", "match": "", "ok": false},
    {"allowed": ["https://example.com"], "origin": "null", "match": "", "ok": false}
  ]
